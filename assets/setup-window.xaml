<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" TextElement.FontSize="14" TextElement.Foreground="#242735">
  <Grid.Resources>
    <SolidColorBrush x:Key="Accent" Color="#6854E9"/>
    <SolidColorBrush x:Key="Line" Color="#E5E3EF"/>
    <Style TargetType="ToolTip"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="#353240" CornerRadius="6" Padding="9,6"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="EditMenuItem" TargetType="MenuItem"><Setter Property="Padding" Value="11,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Item" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#EEEAFE"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <ContextMenu x:Key="EditMenu" ItemContainerStyle="{StaticResource EditMenuItem}" HasDropShadow="False"><ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="White" BorderBrush="#DED9ED" BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="130"><StackPanel IsItemsHost="True"/></Border></ControlTemplate></ContextMenu.Template><MenuItem Header="剪切" Command="ApplicationCommands.Cut"/><MenuItem Header="复制" Command="ApplicationCommands.Copy"/><MenuItem Header="粘贴" Command="ApplicationCommands.Paste"/><MenuItem Header="全选" Command="ApplicationCommands.SelectAll"/></ContextMenu>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#343747"/><Setter Property="BorderBrush" Value="#DEDCEB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/><Border x:Name="Focus" CornerRadius="8" BorderBrush="#9E91F4" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.83"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/><Setter Property="Opacity" Value="0.65"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="MinHeight" Value="42"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#303443"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="ContextMenu" Value="{StaticResource EditMenu}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid><Border CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}"/><Border x:Name="Focus" CornerRadius="8" BorderBrush="{StaticResource Accent}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,7,0,7"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1" BorderBrush="#C8C3DA" Background="White" VerticalAlignment="Center"/><Path x:Name="Tick" Data="M 4 9 L 8 13 L 15 5" Stroke="White" StrokeThickness="2" Width="18" Height="18" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/><Border x:Name="Focus" Grid.ColumnSpan="2" BorderBrush="#AFA4F1" BorderThickness="1" CornerRadius="4" Opacity="0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Margin="2"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#C8C2DF"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="DirectoryItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="2,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EEEAFE"/><Setter TargetName="Row" Property="BorderBrush" Value="#D4CCF9"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F3F0FD"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Grid.Resources>
  <Border x:Name="MainSurface" CornerRadius="16" Background="White" BorderBrush="#E4E0EF" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="TitleDrag" Background="Transparent" Margin="22,0,10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
        <Viewbox Width="24" Height="24" Margin="0,0,10,0"><Canvas Width="64" Height="64"><Rectangle Canvas.Left="2" Canvas.Top="2" Width="60" Height="60" RadiusX="16" RadiusY="16" Fill="Black"/><Path Data="M18 15H33V29H46V49H18Z M37 17L45 25H37Z" Fill="White"/><Path Data="M25 39L36 28L41 33L30 44L23 46Z" Fill="Black"/></Canvas></Viewbox>
        <TextBlock x:Name="Caption" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="序作工作台 · 安装"/>
        <Button x:Name="MinimizeButton" AutomationProperties.Name="最小化" Grid.Column="2" Style="{StaticResource Quiet}" Content="─" ToolTip="最小化"/>
        <Button x:Name="CloseButton" AutomationProperties.Name="关闭维护窗口" Grid.Column="3" Style="{StaticResource Quiet}" Content="×" FontSize="22" ToolTip="关闭"/>
      </Grid>
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"/>
      <Grid x:Name="StartPage" Grid.Row="1" Margin="32,22,32,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock x:Name="StartEyebrow" Text="XUZUO STUDIO" Foreground="#7F739D" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="StartHeading" Text="准备好，开始创作。" FontSize="28" FontWeight="Bold" Margin="0,7,0,8"/><TextBlock x:Name="StartDescription" Text="安装序作工作台，让每一份作品都有独立的空间。" TextWrapping="Wrap" Foreground="#62677A" LineHeight="23"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
          <Border Background="#F7F5FD" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock x:Name="VersionHeading" Text="序作工作台" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="VersionDetail" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="22" Foreground="#6F7282" Text="本地创作与交付工作台"/></StackPanel></Border>
          <StackPanel x:Name="DirectorySection" Margin="0,18,0,0"><TextBlock Text="安装位置" FontWeight="SemiBold" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="InstallDirectory" AutomationProperties.Name="安装位置" Style="{StaticResource Input}" IsReadOnly="True"/><Button x:Name="ChangeDirectoryButton" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Action}" Content="更改位置"/></Grid><TextBlock x:Name="DirectoryNote" Margin="0,7,0,0" Text="默认安装到你的个人目录，无需管理员权限。" Foreground="#797B89" FontSize="12" TextWrapping="Wrap"/></StackPanel>
          <StackPanel x:Name="InstallOptions" Margin="0,14,0,0"><CheckBox x:Name="DesktopShortcut" Style="{StaticResource Check}" Content="创建桌面快捷方式" IsChecked="True"/><CheckBox x:Name="LaunchAfter" Style="{StaticResource Check}" Content="安装完成后打开序作工作台" IsChecked="True"/></StackPanel>
          <Border x:Name="PreserveNotice" Background="#F5F8F5" CornerRadius="8" Padding="13" Margin="0,14,0,0"><TextBlock x:Name="PreserveText" Text="你的项目、作品文件、费用记录和本地密钥独立保存。" Foreground="#526B5A" TextWrapping="Wrap" LineHeight="22"/></Border>
          <TextBlock x:Name="StartError" Foreground="#B9434A" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel></ScrollViewer>
      </Grid>
      <Grid x:Name="OperationPage" Grid.Row="1" Margin="38,30,38,26" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="1"><Border Width="64" Height="64" Background="#F1EDFD" CornerRadius="18" HorizontalAlignment="Left"><TextBlock x:Name="StateSymbol" Text="↓" FontSize="32" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock x:Name="OperationHeading" Text="正在安装" FontWeight="Bold" FontSize="28" Margin="0,20,0,10"/><TextBlock x:Name="OperationDetail" TextWrapping="Wrap" Foreground="#62677A" LineHeight="24"/><Border x:Name="ProgressTrack" Height="7" Background="#EEEBF7" CornerRadius="4" Margin="0,25,0,0"><Grid ClipToBounds="True"><Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="{StaticResource Accent}" CornerRadius="4" Width="0"/></Grid></Border><TextBlock x:Name="ProgressText" Foreground="#76798A" FontSize="12" Margin="0,9,0,0"/><TextBox x:Name="ErrorDetail" AutomationProperties.Name="详细原因" Style="{StaticResource Input}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" Visibility="Collapsed"/></StackPanel>
      </Grid>
      <Grid x:Name="PickerPage" Grid.Row="1" Margin="20,13,20,16" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="选择安装文件夹" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="BackButton" AutomationProperties.Name="返回上个目录" Style="{StaticResource Quiet}" Content="←" ToolTip="返回上个目录"/><Button x:Name="UpButton" AutomationProperties.Name="上一级目录" Grid.Column="1" Style="{StaticResource Quiet}" Content="↑" ToolTip="上一级"/><TextBox x:Name="PickerPath" AutomationProperties.Name="目录路径" Grid.Column="2" Style="{StaticResource Input}" Margin="5,0,8,0" ToolTip="输入完整路径后按回车"/><Button x:Name="GoButton" Grid.Column="3" Style="{StaticResource Action}" Content="前往"/></Grid><WrapPanel x:Name="Breadcrumbs" Margin="73,6,0,6" MaxHeight="54" ClipToBounds="True"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#F8F6FD" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="8"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Locations"><TextBlock Text="常用位置与磁盘" Foreground="#7E7890" FontSize="12" Margin="9,7,0,10"/></StackPanel></ScrollViewer></Border><Grid Grid.Column="1" Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DirectoryCount" VerticalAlignment="Center" Foreground="#777B8B"/><Button x:Name="NewFolderButton" Grid.Column="1" Style="{StaticResource Action}" Content="＋ 新建文件夹"/></Grid><Border x:Name="NewFolderForm" Grid.Row="1" Background="#F5F2FE" BorderBrush="#E6DFFA" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBox x:Name="NewFolderName" AutomationProperties.Name="新文件夹名称" Style="{StaticResource Input}" Text="序作工作台"/><Button x:Name="CreateFolderButton" Grid.Column="1" Margin="8,0,4,0" Style="{StaticResource Primary}" Content="创建"/><Button x:Name="CancelNewFolderButton" AutomationProperties.Name="取消新建文件夹" Grid.Column="2" Style="{StaticResource Quiet}" Content="×"/></Grid></Border><Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"><Grid><ListBox x:Name="Directories" AutomationProperties.Name="子文件夹" FocusVisualStyle="{x:Null}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ItemContainerStyle="{StaticResource DirectoryItem}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="18" Height="16" Stretch="Fill" Data="M1 3 L8 3 L10 5 L22 5 L22 19 L1 19 Z" Stroke="#7B69C5" StrokeThickness="1.6" Fill="Transparent" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="DirectoryEmpty" Text="这里没有子文件夹，可以新建一个。" Foreground="#858294" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="25" IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border></Grid></Grid>
        <StackPanel Grid.Row="2"><TextBlock x:Name="PickerError" Foreground="#B9434A" TextWrapping="Wrap" Margin="0,0,0,5"/><TextBlock x:Name="PickerTarget" TextWrapping="Wrap" Foreground="#666B7C" FontSize="12" MaxHeight="44"/></StackPanel>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="24,0,24,0" Padding="0,16,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterNote" Text="本地安装 · 作品资料独立保存" Foreground="#8A8798" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/><Button x:Name="SecondaryButton" Grid.Column="1" Style="{StaticResource Action}" Content="暂不安装" Margin="0,0,10,0"/><Button x:Name="PrimaryButton" Grid.Column="2" Style="{StaticResource Primary}" Content="开始安装" MinWidth="128"/></Grid></Border>
    </Grid>
  </Border>
  <Border x:Name="ConfirmOverlay" Background="#6B252336" CornerRadius="16" Visibility="Collapsed"><Border Width="420" MaxWidth="600" Background="White" CornerRadius="13" BorderBrush="#E3DDEF" BorderThickness="1" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="ConfirmHeading" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="ConfirmDetail" TextWrapping="Wrap" Foreground="#656B7C" LineHeight="23" Margin="0,12,0,22"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="ConfirmCancel" Style="{StaticResource Action}" Content="继续安装" Margin="0,0,9,0"/><Button x:Name="ConfirmAccept" Style="{StaticResource Primary}" Content="退出"/></WrapPanel></StackPanel></Border></Border>
</Grid>
