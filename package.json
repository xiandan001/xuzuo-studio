{
  "name": "xuzuo-studio",
  "private": true,
  "version": "2.1.6",
  "description": "序作工作台：真实AI工作流与文件交付",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/run-ui.mjs dev",
    "build": "node scripts/run-ui.mjs build",
    "preview": "node scripts/run-ui.mjs preview",
    "desktop": "node scripts/run-ui.mjs desktop",
    "test": "node scripts/run-ui.mjs test",
    "package": "node scripts/run-ui.mjs package"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pptxgenjs": "4.0.1",
    "docx": "9.15.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "saxes": "5.0.1",
    "image-size": "2.0.4",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "pdfjs-dist": "5.6.205",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "local.xuzuo.studio",
    "productName": "序作工作台",
    "directories": {
      "output": "outputs/release-v2.1.6"
    },
    "asarUnpack": [
      "assets/windows-drive-info.exe"
    ],
    "extraResources": [
      {
        "from": "work/setup-runtime/xuzuo-maintenance.exe",
        "to": "xuzuo-maintenance.exe"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "!assets/setup-window.xaml",
      "package.json",
      "!electron/credential-self-test.cjs",
      "!electron/live-self-test.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.ico",
      "signExecutable": false
    }
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
